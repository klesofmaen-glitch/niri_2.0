layout {

    focus-ring {
        active-color   "#b4c9e1"
        inactive-color "#121315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b4c9e1"
        inactive-color "#121315"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b4c9e1"
        inactive-color "#35485d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b4c9e180"
    }
}

recent-windows {
    highlight {
        active-color "#b4c9e1"
        urgent-color "#ffb4ab"
    }
}
